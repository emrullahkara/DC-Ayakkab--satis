# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun.

# Sistem yöneticisi (firma kodu: sistem, kullanıcı: admin) şifresi — ZORUNLU, güçlü bir şifre yazın
ADMIN_PASSWORD=degistir-beni-123

# Oturum imza anahtarı (boş bırakılırsa ilk açılışta üretilip /data içinde saklanır)
JWT_SECRET=

# Örnek/demo firma verisi oluşturulsun mu? (1 = evet; tanıtım için)
DEMO_DATA=0

# Dış port
PORT=3000

# HTTPS kullanıyorsanız (Caddy profili veya başka bir reverse proxy) 1 yapın
COOKIE_SECURE=0

# HTTPS profili için alan adı (DNS'i sunucuya yönlendirilmiş olmalı)
DOMAIN=

# Saklanacak otomatik yedek sayısı
BACKUP_KEEP=14
